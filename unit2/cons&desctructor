8. Constructor Using Initialization List

A constructor initialization list is a special syntax used to initialize data members of a class before the constructor body is executed.

Initialization List constructor की एक special syntax है, जिसका उपयोग class के data members को constructor body execute होने से पहले initialize करने के लिए किया जाता है।

// syntax:
// ClassName(parameters) : dataMember1(value1), dataMember2(value2)
// {
//     // constructor body
// }

#include <iostream>
using namespace std;

class Student
{
public:
    string name;
    int age;

    Student(string n, int a) : name(n), age(a)
    {
    }

    void display()
    {
        cout << "Name = " << name << endl;
        cout << "Age = " << age << endl;
    }
};

int main()
{
    Student s1("Adil", 22);

    s1.display();

    return 0;
}



10. Constructor Outside the Class

A constructor can be declared inside the class and defined outside the class using the Scope Resolution Operator (::).


Constructor को class के अंदर declare करके class के बाहर define किया जा सकता है। इसके लिए Scope Resolution Operator (::) का use किया जाता है।

#include <iostream>
using namespace std;

class Student
{
public:
    int age;

    Student();

    void display();
};

// Constructor definition outside class
Student::Student()
{
    age = 22;
}

void Student::display()
{
    cout << "Age = " << age << endl;
}

int main()
{
    Student s1;

    s1.display();

    return 0;
}

// Important Operator
// Student::Student()

//  :: को Scope Resolution Operator कहते हैं।

//c&d

#include <iostream>
using namespace std;

class Student
{
public:

    // Constructor
    Student()
    {
        cout << "Constructor Called" << endl;
        cout << "Object Created" << endl;
    }

    // Destructor
    ~Student()
    {
        cout << "Destructor Called" << endl;
        cout << "Object Destroyed" << endl;
    }
};

int main()
{
    Student s1;

    cout << "Object is Working" << endl;

    return 0;
}

