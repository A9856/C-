#include <iostream>
#include <string>
using namespace std;

// =====================================================
// ABSTRACT BASE CLASS
// =====================================================
class Person
{
protected:
    string name;
    int age;

public:
    // Constructor
    Person(string n, int a)
    {
        name = n;
        age = a;
        cout << "Person Constructor: "
             << name << endl;
    }
    // Normal Member Function
    void showBasicInfo()
    {
        cout << "Name: " << name << endl;
        cout << "Age : " << age << endl;
    }
    // Normal Virtual Function
    virtual void role()
    {
        cout << "Person role" << endl;
    }
    // Pure Virtual Function
    virtual void work() = 0;

    // Another Pure Virtual Function
    virtual void displayDetails() = 0;

    // Virtual Destructor
    virtual ~Person()
    {
        cout << "Person Destructor: "
             << name << endl;
    }
};

// =====================================================
// STUDENT CLASS
// =====================================================
class Student : public Person
{
private:
    int rollNo;
    int marks;

public:
    // Constructor
    Student(string n, int a, int r, int m) : Person(n, a)
    {
        rollNo = r;
        marks = m;

        cout << "Student Constructor: "
             << name << endl;
    }
    // Override Normal Virtual Function
    void role() override
    {
        cout << "Role: Student" << endl;
    }

    // Override Pure Virtual Function
    void work() override
    {
        cout << "Student is studying." << endl;
    }

    // Override Second Pure Virtual Function
    void displayDetails() override
    {
        cout << "Roll No: " << rollNo << endl;
        cout << "Marks  : " << marks << endl;
    }

    // Destructor
    ~Student()
    {
        cout << "Student Destructor: "
             << name << endl;
    }
};

// =====================================================
// TEACHER CLASS
// =====================================================

class Teacher : public Person
{
private:
    string subject;
    double salary;

public:
    // Constructor
    Teacher(string n, int a, string s, double sal) : Person(n, a)
    {
        subject = s;
        salary = sal;

        cout << "Teacher Constructor: "
             << name << endl;
    }

    // Override Normal Virtual Function
    void role() override
    {
        cout << "Role: Teacher" << endl;
    }

    // Override Pure Virtual Function
    void work() override
    {
        cout << "Teacher is teaching." << endl;
    }

    // Override Pure Virtual Function
    void displayDetails() override
    {
        cout << "Subject: " << subject << endl;
        cout << "Salary : " << salary << endl;
    }

    // Destructor
    ~Teacher()
    {
        cout << "Teacher Destructor: "
             << name << endl;
    }
};

// =====================================================
// STAFF CLASS
// =====================================================
class Staff : public Person
{
private:
    string department;

public:
    // Constructor
    Staff(string n, int a, string d) : Person(n, a)
    {
        department = d;
        cout << "Staff Constructor: "
             << name << endl;
    }

    // Override Normal Virtual Function
    void role() override
    {
        cout << "Role: Administrative Staff" << endl;
    }

    // Override Pure Virtual Function
    void work() override
    {
        cout << "Staff is managing office work." << endl;
    }

    // Override Pure Virtual Function
    void displayDetails() override
    {
        cout << "Department: "
             << department << endl;
    }

    // Destructor
    ~Staff()
    {
        cout << "Staff Destructor: "
             << name << endl;
    }
};

// =====================================================
// FUNCTION TO DISPLAY ANY PERSON
// =====================================================

void displayPerson(Person *p)
{
    cout << "\n-----------------------------" << endl;

    p->showBasicInfo();

    // Runtime Polymorphism
    p->role();

    p->work();

    p->displayDetails();

    cout << "-----------------------------" << endl;
}

// =====================================================
// MAIN FUNCTION
// =====================================================

int main()
{
    cout << "\n====================================" << endl;
    cout << "      SCHOOL MANAGEMENT SYSTEM" << endl;
    cout << "====================================\n"
         << endl;

    // =================================================
    // 1. NORMAL / STACK OBJECT
    // =================================================

    cout << "\n1. NORMAL OBJECT\n"<< endl;

    Student s1("Aman", 20, 101, 85);

    s1.showBasicInfo();
    s1.role();
    s1.work();
    s1.displayDetails();

    // =================================================
    // 2. ANOTHER NORMAL OBJECT
    // =================================================

    cout << "\n2. NORMAL TEACHER OBJECT\n"<< endl;

    Teacher t1("Rahul",35,"Computer Science",45000);

    t1.showBasicInfo();
    t1.role();
    t1.work();
    t1.displayDetails();

    // =================================================
    // 3. DYNAMIC OBJECT USING new
    // =================================================

    cout << "\n3. DYNAMIC OBJECT\n"
         << endl;

    Student *s2 =new Student("Priya", 19, 102, 92);

    s2->showBasicInfo();
    s2->role();
    s2->work();
    s2->displayDetails();

    // =================================================
    // 4. MANUAL delete
    // =================================================

    cout << "\n4. MANUAL DELETE\n"
         << endl;

    delete s2;
    s2 = nullptr;

    // =================================================
    // 5. BASE CLASS POINTER
    // =================================================

    cout << "\n5. BASE CLASS POINTER\n"
         << endl;

    Teacher t2("Anita",40,"Mathematics",55000);

    Person *ptr = &t2;
    ptr->showBasicInfo();

    // Runtime Polymorphism
    ptr->role();
    ptr->work();
    ptr->displayDetails();

    // =================================================
    // 6. BASE POINTER + DYNAMIC DERIVED OBJECT
    // =================================================

    cout << "\n6. BASE POINTER + DYNAMIC OBJECT\n"
         << endl;

    Person *p1 =new Student("Ravi", 21, 103, 78);

    p1->showBasicInfo();
    p1->role();
    p1->work();
    p1->displayDetails();

    delete p1;
    p1 = nullptr;

    // =================================================
    // 7. MULTIPLE DYNAMIC OBJECTS
    // =================================================

    cout << "\n7. MULTIPLE DYNAMIC OBJECTS\n"
         << endl;

    Person *p2 =new Teacher("Suresh",42,"Physics",60000);
    Person *p3 =new Staff("Neha",30,"Administration");

    displayPerson(p2);
    displayPerson(p3);

    delete p2;
    delete p3;
    p2 = nullptr;
    p3 = nullptr;

    // =================================================
    // 8. RUNTIME SIZE DYNAMIC ARRAY
    // =================================================

    cout << "\n8. DYNAMIC ARRAY\n"
         << endl;

    int n;
    cout << "Enter number of students: ";
    cin >> n;

    int *marks = new int[n];

    cout << "\nEnter marks:\n";

    for (int i = 0; i < n; i++)
    {
        cout << "Student "<< i + 1<< ": ";
       cin >> marks[i];
    }

    cout << "\nEntered Marks:\n";
    for (int i = 0; i < n; i++)
    {
        cout << "Student "<< i + 1<< " = "<< marks[i]<< endl;
    }

    // Release dynamic array
    delete[] marks;
    marks = nullptr;

    // =================================================
    // 9. MULTIPLE DERIVED OBJECTS THROUGH
    //    BASE CLASS POINTER ARRAY
    // =================================================

    cout << "\n9. POLYMORPHISM USING POINTER ARRAY\n"
         << endl;

    Person *people[3];

    people[0] =new Student("Karan",20,104,88);
    people[1] =new Teacher("Meena",38,"English",50000);
    people[2] =new Staff("Vikas",32,"Accounts");

    for (int i = 0; i < 3; i++)
    {
        displayPerson(people[i]);
    }

    // Delete all dynamic objects

    for (int i = 0; i < 3; i++)
    {
        delete people[i];

        people[i] = nullptr;
    }

    cout << "\n====================================" << endl;
    cout << "        PROGRAM FINISHED" << endl;
    cout << "====================================" << endl;

    return 0;
}